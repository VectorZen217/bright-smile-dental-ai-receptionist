# Copy to .env.local and fill in your own keys. Never commit .env.local.
# Get a Gemini key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# DEMO_MODE=true uses the built-in rule-based replies and needs no key.
# Set to false once GEMINI_API_KEY is set to call Gemini.
DEMO_MODE=true
